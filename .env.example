# Rustok stack environment. Copy to .env (chmod 600) and fill in. No defaults
# here are real secrets — never commit .env.

# --- required in every mode ---

# Password unlocking the Core keyring at startup.
RUSTOK_KEYRING_PASSWORD=

# --- required by the `prod` profile (TLS via Caddy) ---

# Public domain Caddy serves and requests a Let's Encrypt cert for.
# Use `localhost` to test the prod profile locally (Caddy internal CA).
RUSTOK_PUBLIC_DOMAIN=

# ACME account email (Let's Encrypt expiry/problem notices).
RUSTOK_ACME_EMAIL=

# --- optional ---

# Comma-separated allowed chain IDs (default: 1,8453).
RUSTOK_ALLOWED_CHAINS=

# Alchemy API key for RPC; falls back to public RPCs when empty.
RUSTOK_ALCHEMY_API_KEY=

# Shared key MCP presents to Gateway; auth disabled when empty (dev only).
RUSTOK_MCP_API_KEY=
