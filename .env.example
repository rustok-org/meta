# Rustok stack environment. Copy to .env (chmod 600) and fill in. No defaults
# here are real secrets — never commit .env.

# --- required in every mode ---

# Password unlocking the Core keyring at startup.
RUSTOK_KEYRING_PASSWORD=

# --- required by the prod overlay (docker-compose.prod.yml, TLS via Caddy) ---

# Public domain Caddy serves and requests a Let's Encrypt cert for.
# Use `localhost` to test the prod overlay locally (Caddy internal CA).
RUSTOK_PUBLIC_DOMAIN=

# ACME account email (Let's Encrypt expiry/problem notices).
RUSTOK_ACME_EMAIL=

# Inbound bearer key clients must present to MCP. REQUIRED by the prod overlay
# (the stack refuses to start without it); leave empty for the loopback dev
# flow. Generate a high-entropy value:
#   openssl rand -hex 32
# MUST be non-whitespace: compose ${VAR:?} accepts a blank/whitespace value,
# but MCP normalizes a whitespace-only key to "unset" — which would silently
# DISABLE inbound auth. `openssl rand -hex 32` output is always safe.
RUSTOK_MCP_INBOUND_API_KEY=

# --- optional ---

# Comma-separated allowed chain IDs (default: 1,8453).
RUSTOK_ALLOWED_CHAINS=

# Alchemy API key for RPC; falls back to public RPCs when empty.
RUSTOK_ALCHEMY_API_KEY=

# Shared key MCP presents to Gateway; auth disabled when empty (dev only).
RUSTOK_MCP_API_KEY=

# Log verbosity for the Rust services (gateway/core), tracing EnvFilter syntax.
# Unset → `info`. Example: `info,rustok_gateway=debug,rustok_grpc=debug`.
RUST_LOG=

# --- required by the observability overlay (docker-compose.obs.yml) ---

# Grafana admin password. REQUIRED when the obs overlay is up (the stack refuses
# to start without it). Generate:
#   openssl rand -hex 16
GF_SECURITY_ADMIN_PASSWORD=

# OTLP/HTTP collector endpoint for distributed traces. The obs overlay sets this
# to http://alloy:4318 for core/gateway automatically; override only to point at
# a different collector. Unset (plain `docker compose up`) → JSON logs only, no
# trace export. Must be an http(s):// URL or the service fails fast at startup.
RUSTOK_OTLP_ENDPOINT=
